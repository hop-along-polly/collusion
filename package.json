{
  "name": "collusion-flashcards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Flashcards generated from the certification study notes in this repository.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && tsc -b && vite build",
    "postbuild": "node scripts/write-spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx scripts/validate-data.ts",
    "deploy": "npm run build && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.2.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
